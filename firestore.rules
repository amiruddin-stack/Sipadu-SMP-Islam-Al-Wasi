rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'amiruddin@smpialwasi-maros.sch.id' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function canManageExamQuestions() {
      return isAdmin() || (isSignedIn() &&
        request.auth.token.email.matches('.*@smpialwasi-maros\\.sch\\.id') &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['guru', 'wali_kelas']);
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Students master data
    match /students/{studentId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Attendance records
    match /attendance/{attendanceId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Teacher Journals
    match /journals/{journalId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Student Behavior Records
    match /behaviors/{behaviorId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Confidential BK Counseling Records - Restricted to BK Counselors and Admin
    match /counseling/{counselingId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Academic Assessments and Grades
    match /assessments/{assessmentId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Settings
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /examQuestions/{questionId} {
      allow read, write: if isAdmin();
    }
    match /examPublicQuestions/{questionId} {
      allow read: if isSignedIn();
      allow create, update: if canManageExamQuestions() && !('answer' in request.resource.data);
      allow delete: if canManageExamQuestions();
    }
    match /examAnswerKeys/{questionId} {
      allow read: if isAdmin();
      allow create, update, delete: if canManageExamQuestions();
    }
    match /exams/{examId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
    match /examStudentCodes/{code} {
      allow get: if isSignedIn() && resource.data.active == true &&
        (resource.data.ownerUid == null || resource.data.ownerUid == request.auth.uid);
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (isSignedIn() && resource.data.active == true &&
          resource.data.ownerUid == null &&
          request.resource.data.ownerUid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid']));
    }
    match /examAttempts/{attemptId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && incoming().ownerUid == request.auth.uid && !('score' in incoming()) && !('total' in incoming()) && !('percent' in incoming());
      allow update: if isAdmin() || (isSignedIn() && existing().ownerUid == request.auth.uid && incoming().ownerUid == request.auth.uid && existing().status == 'Mengerjakan' && !('score' in incoming()) && !('total' in incoming()) && !('percent' in incoming()));
      allow delete: if isAdmin();
    }
  }
}
