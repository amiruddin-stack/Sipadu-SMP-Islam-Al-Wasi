rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSchoolIdentity() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('^[^@]+@smpialwasi-maros\\.sch\\.id$')
        && request.auth.token.firebase.sign_in_provider in ['password', 'google.com'];
    }

    function userProfileExists() {
      return isSchoolIdentity()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return userProfileExists()
        && userRole() == 'super_admin'
        && request.auth.token.email == 'amiruddin@smpialwasi-maros.sch.id';
    }

    function isGuruOrAdmin() {
      return userProfileExists()
        && userRole() in ['super_admin', 'guru'];
    }

    function validProfile(userId) {
      return isSchoolIdentity()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'nip', 'assignedClass', 'subject', 'phone', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 100
        && (!('createdAt' in request.resource.data) || (request.resource.data.createdAt is string && request.resource.data.createdAt.size() <= 50))
        && request.resource.data.role == (
          request.auth.token.email == 'amiruddin@smpialwasi-maros.sch.id' ? 'super_admin' : 'guru'
        );
    }

    function validStudentRegistration(studentId) {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && studentId.size() == 68
        && studentId.matches('^std-[a-f0-9]+$')
        && request.resource.data.keys().hasOnly([
          'id', 'nis', 'nisn', 'name', 'gender', 'className',
          'status', 'registeredAt', 'registrationSource'
        ])
        && request.resource.data.id == studentId
        && request.resource.data.nis is string
        && request.resource.data.nis.size() <= 30
        && request.resource.data.nisn is string
        && request.resource.data.nisn.size() <= 30
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 100
        && request.resource.data.gender in ['L', 'P']
        && request.resource.data.className in ['VII (Tujuh)', 'VIII (Delapan)', 'IX (Sembilan)']
        && request.resource.data.status == 'menunggu'
        && request.resource.data.registeredAt is string
        && request.resource.data.registeredAt.size() <= 50
        && request.resource.data.registrationSource == 'public_form'
        && !exists(/databases/$(database)/documents/students/$(studentId));
    }

    match /users/{userId} {
      allow get: if isSchoolIdentity()
        && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      // Akun hanya dapat membuat profil dirinya dengan peran awal yang ditentukan server-side.
      allow create: if validProfile(userId);

      // Pengguna tidak dapat mengubah perannya sendiri. Perubahan peran hanya oleh admin.
      allow update: if isAdmin()
        || (validProfile(userId)
          && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    match /students/{studentId} {
      // Guru dan admin boleh membaca data siswa; akun anonim tetap ditolak.
      allow read: if isGuruOrAdmin();
      // Impor Excel memakai setDoc(..., {merge:true}); admin perlu create dan update.
      allow create: if isAdmin() || validStudentRegistration(studentId);
      allow update, delete: if isAdmin();
    }

    match /attendance/{id} {
      allow read, write: if isGuruOrAdmin();
    }
    match /attendance_history/{id} {
      allow read, write: if isGuruOrAdmin();
    }
    match /journals/{id} {
      allow read, write: if isGuruOrAdmin();
    }
    match /behaviors/{id} {
      allow read, write: if isGuruOrAdmin();
    }
    match /counseling/{id} {
      allow read, write: if isAdmin()
        || (userProfileExists() && userRole() == 'guru_bk');
    }
    match /assessments/{id} {
      allow read, write: if isGuruOrAdmin();
    }
    match /settings/{id} {
      allow read: if isGuruOrAdmin();
      allow write: if isAdmin();
    }
    match /teachers/{id} {
      allow read: if isGuruOrAdmin();
      allow write: if isAdmin();
    }
    match /master_classes/{id} {
      allow read: if isGuruOrAdmin();
      allow write: if isAdmin();
    }
    match /master_subjects/{id} {
      allow read: if isGuruOrAdmin();
      allow write: if isAdmin();
    }
    match /extracurriculars/{id} {
      allow read, write: if isGuruOrAdmin();
    }

    match /examQuestions/{questionId} {
      allow read, write: if isAdmin();
    }

    match /examPublicQuestions/{questionId} {
      // Koleksi ini khusus konten soal publik; kunci jawaban harus disimpan terpisah.
      allow read: if (signedIn()
          && request.auth.token.firebase.sign_in_provider == 'anonymous'
          && resource.data.keys().hasOnly([
            'title', 'subject', 'className', 'academicYear', 'semester',
            'prompt', 'options', 'points', 'createdAt'
          ]))
        || isGuruOrAdmin();
      allow create, update: if isGuruOrAdmin()
        && request.resource.data.keys().hasOnly([
          'title', 'subject', 'className', 'academicYear', 'semester',
          'prompt', 'options', 'points', 'createdAt'
        ]);
      allow delete: if isGuruOrAdmin();
    }

    match /examAnswerKeys/{questionId} {
      allow read, write: if isGuruOrAdmin();
    }

    match /exams/{examId} {
      allow read: if isGuruOrAdmin()
        || (signedIn()
          && request.auth.token.firebase.sign_in_provider == 'anonymous'
          && resource.data.status == 'Aktif');
      allow create, update, delete: if isGuruOrAdmin();
    }

    match /examStudentCodes/{code} {
      allow get: if isAdmin()
        || (signedIn()
          && request.auth.token.firebase.sign_in_provider == 'anonymous'
          && resource.data.active == true
          && (resource.data.ownerUid == null || resource.data.ownerUid == request.auth.uid));
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn()
          && request.auth.token.firebase.sign_in_provider == 'anonymous'
          && resource.data.active == true
          && resource.data.ownerUid == null
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid']));
    }

    match /examAttempts/{attemptId} {
      allow read: if isGuruOrAdmin()
        || (signedIn()
          && request.auth.token.firebase.sign_in_provider == 'anonymous'
          && resource.data.ownerUid == request.auth.uid);

      allow create: if signedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && request.resource.data.keys().hasOnly([
          'examId', 'examTitle', 'studentId', 'studentName', 'className',
          'answers', 'ownerUid', 'status', 'startedAt'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.examId is string
        && request.resource.data.examId.size() <= 128
        && request.resource.data.studentId is string
        && request.resource.data.studentId.size() <= 128
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() <= 100
        && request.resource.data.className is string
        && request.resource.data.className.size() <= 30
        && request.resource.data.answers is map
        && request.resource.data.status == 'Mengerjakan'
        && request.resource.data.startedAt is string
        && exists(/databases/$(database)/documents/exams/$(request.resource.data.examId))
        && get(/databases/$(database)/documents/exams/$(request.resource.data.examId)).data.status == 'Aktif';

      allow update: if isGuruOrAdmin()
        || (signedIn()
          && request.auth.token.firebase.sign_in_provider == 'anonymous'
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == request.auth.uid
          && resource.data.status == 'Mengerjakan'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'answers', 'status', 'submittedAt', 'autoSubmitted', 'lastSavedAt'
          ])
          && request.resource.data.answers is map
          && request.resource.data.status in ['Mengerjakan', 'Selesai']
          && (!('submittedAt' in request.resource.data)
            || request.resource.data.submittedAt is string)
          && (!('autoSubmitted' in request.resource.data)
            || request.resource.data.autoSubmitted is bool)
          && (!('lastSavedAt' in request.resource.data)
            || request.resource.data.lastSavedAt is string));
      allow delete: if isAdmin();
    }

    // Default deny: semua koleksi/dokumen lain tertutup kecuali diizinkan eksplisit di atas.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}